<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CheckCar.Views.ReturnsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ViewModels="clr-namespace:CheckCar.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Retorno de Vehículos"
    BackgroundColor="{AppThemeBinding Light=WhiteSmoke,
                                      Dark=#121212}">

    <ContentPage.BindingContext>
        <ViewModels:ReturnsPageVM />
    </ContentPage.BindingContext>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadDataCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!--  Swipe-to-Refresh  -->
        <RefreshView
            Grid.Row="0"
            Command="{Binding LoadDataCommand}"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">

            <CollectionView
                BackgroundColor="{AppThemeBinding Light=WhiteSmoke,
                                                  Dark=#121212}"
                ItemsSource="{Binding Returns, Mode=OneWay}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="5"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light=White,
                                                              Dark=#1E1E1E}"
                            BorderColor="{AppThemeBinding Light=LightGray,
                                                          Dark=DarkGray}"
                            CornerRadius="8"
                            HasShadow="True">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:ReturnsPageVM}}, Path=ViewReport}" CommandParameter="{Binding ReportId}" />
                            </Frame.GestureRecognizers>

                            <Grid
                                Padding="5"
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto">
                                <!--  Fila 0: Placa y Kilometraje  -->
                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        Text="Placa:"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                    <Label
                                        FontSize="Small"
                                        Text="{Binding CarPlate}"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                </StackLayout>

                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        Text="Kilometraje:"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                    <Label
                                        FontSize="Small"
                                        Text="{Binding mileage, StringFormat='{0:N0}'}"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                </StackLayout>

                                <!--  Fila 1: Fecha  -->
                                <StackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        Text="Fecha:"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                    <Label
                                        FontSize="Small"
                                        Text="{Binding Created}"
                                        TextColor="{AppThemeBinding Light=Black,
                                                                    Dark=White}" />
                                </StackLayout>
                            </Grid>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  Botón Agregar Info  -->
        <Button
            Grid.Row="1"
            Margin="10"
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=#00796B,
                                              Dark=#26A69A}"
            BorderColor="{AppThemeBinding Light=#004D40,
                                          Dark=#80CBC4}"
            BorderWidth="1"
            Command="{Binding ViewAddReturn}"
            CornerRadius="10"
            FontAttributes="Bold"
            HeightRequest="45"
            Text="Agregar Entrega"
            TextColor="{AppThemeBinding Light=White,
                                        Dark=Black}" />
    </Grid>
</ContentPage>
