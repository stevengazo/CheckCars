<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CheckCars.Views.ViewReturn"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ViewModels="clr-namespace:CheckCars.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Información Entrega">

    <ContentPage.BindingContext>
        <ViewModels:ViewReturnsVM />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <!-- Información General -->
            <Frame
                Padding="15"
                CornerRadius="12"
                HasShadow="True"
                BackgroundColor="{AppThemeBinding Light=#f9f9f9, Dark=#2a2a2a}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Detalles del Reporte"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Grid
                        ColumnSpacing="10"
                        RowSpacing="8">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Vehículo -->
                        <Label
                            Grid.Row="0"
                            FontAttributes="Bold"
                            Text="Vehículo:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Report.CarPlate}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                        <!-- Fecha -->
                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            Text="Fecha:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Report.Created}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                        <!-- Autor -->
                        <Label
                            Grid.Row="2"
                            FontAttributes="Bold"
                            Text="Autor:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Report.Author}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                        <!-- Latitud -->
                        <Label
                            Grid.Row="3"
                            FontAttributes="Bold"
                            Text="Latitud:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding Report.Latitude}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                        <!-- Longitud -->
                        <Label
                            Grid.Row="4"
                            FontAttributes="Bold"
                            Text="Longitud:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="4"
                            Grid.Column="1"
                            Text="{Binding Report.Longitude}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                        <!-- Kilometraje -->
                        <Label
                            Grid.Row="5"
                            FontAttributes="Bold"
                            Text="Kilometraje:"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="{Binding Report.mileage, StringFormat='{0:N0} km'}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Imágenes del reporte -->
            <Label
                Text="Imágenes del Reporte"
                FontAttributes="Bold"
                FontSize="Medium"
                Margin="0,10,0,0"
                TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <CollectionView
                Margin="0,5,0,15"
                HorizontalOptions="FillAndExpand"
                ItemsSource="{Binding Report.Photos}"
                VerticalOptions="Start">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="8"
                            Margin="5"
                            CornerRadius="10"
                            HasShadow="True"
                            BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#333333}">
                            <Grid>
                                <Image
                                    Margin="5"
                                    Aspect="AspectFit"
                                    HorizontalOptions="CenterAndExpand"
                                    Source="{Binding FilePath}"
                                    VerticalOptions="Center" />
                                <ImageButton
                                    Margin="5"
                                    Padding="6"
                                    BackgroundColor="blue"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:ViewReturnsVM}}, Path=ShareImage}"
                                    CommandParameter="{Binding FilePath}"
                                    CornerRadius="50"
                                    HeightRequest="50"
                                    HorizontalOptions="End"
                                    Source="share.png"
                                    VerticalOptions="End"
                                    WidthRequest="50" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
