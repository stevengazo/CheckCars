<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CheckCar.Views.Account"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ViewModels="clr-namespace:CheckCar.ViewModels"
    Title="Configuración"
    x:DataType="ViewModels:AccountVM"
    BackgroundColor="{AppThemeBinding Light=White,
                                      Dark=Gray}">

    <ContentPage.BindingContext>
        <ViewModels:AccountVM />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="15" Spacing="10">

            <!--  Sección Usuario  -->
            <Frame
                Padding="5"
                BackgroundColor="{AppThemeBinding Light=#f5f5f5,
                                                  Dark=#2C2C2C}"
                CornerRadius="10">
                <Grid ColumnDefinitions="auto, *, auto" ColumnSpacing="10">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="14"
                        Text="Usuario"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}"
                        VerticalOptions="Center" />
                    <Entry
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#3A3A3A}"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="Nombre de Usuario"
                        Text="{Binding LocalUser.UserName, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Grid.ColumnSpan="2"
                        BackgroundColor="{AppThemeBinding Light=#007AFF,
                                                          Dark=#0A84FF}"
                        Command="{Binding UpdateUser}"
                        CornerRadius="8"
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Actualizar"
                        TextColor="White" />
                </Grid>
            </Frame>

            <!--  Sección de Borrado  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#f5f5f5,
                                                  Dark=#2C2C2C}"
                CornerRadius="10">
                <Grid
                    ColumnDefinitions="*, auto, auto"
                    RowDefinitions="auto,auto"
                    RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="14"
                        Text="Borrar Reportes existentes"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#D32F2F,
                                                          Dark=#EF5350}"
                        Command="{Binding CleanReports}"
                        CornerRadius="8"
                        FontSize="Small"
                        Text="Borrar"
                        TextColor="White" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="14"
                        Text="Borrar PDFs existentes"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#FF9800,
                                                          Dark=#FFA726}"
                        Command="{Binding CleanPdfs}"
                        CornerRadius="8"
                        FontSize="Small"
                        Text="Borrar"
                        TextColor="White" />
                </Grid>
            </Frame>

            <!--  Sección de Configuración del Servidor  -->
            <Frame
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#f5f5f5,
                                                  Dark=#2C2C2C}"
                CornerRadius="10">
                <Grid
                    ColumnDefinitions="auto, *"
                    RowDefinitions="auto,auto"
                    RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Servidor"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}"
                        VerticalTextAlignment="Center" />
                    <Entry
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#3A3A3A}"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="http://8.8.8.8"
                        Text="{Binding URL}"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Puerto"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}"
                        VerticalTextAlignment="Center" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#3A3A3A}"
                        FontSize="14"
                        HeightRequest="40"
                        Placeholder="8080"
                        Text="{Binding Port}"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" />
                </Grid>
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>
