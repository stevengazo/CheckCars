<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReviCar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:VM="clr-namespace:ReviCar.ViewModels"
    xmlns:Views="clr-namespace:ReviCar.Views"
    xmlns:local="clr-namespace:ReviCar"
    Title="ReviCar"
    BackgroundColor="LightBlue"
    FlyoutBackgroundColor="{AppThemeBinding Light=LightGray,
                                            Dark=DarkGray}"
    Shell.FlyoutBehavior="Flyout"
    Shell.TabBarIsVisible="False"
    TitleColor="{AppThemeBinding Light=Black,
                                 Dark=White}">

    <Shell.BindingContext>
        <VM:AppShellVM />
    </Shell.BindingContext>

    <Shell.FlyoutHeader>
        <Image
            HorizontalOptions="Center"
            Source="checkcar.png"
            WidthRequest="180" />
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Option" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Reportes"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Vehículos"
            ContentTemplate="{DataTemplate Views:CarList}"
            Route="CarList" />
        <!--
            ShellContent
            Title="Reservas"
            ContentTemplate="{DataTemplate Views:BookingList}"
            Route="Booking" /
        -->
        <ShellContent
            Title="Configuración"
            ContentTemplate="{DataTemplate Views:Account}"
            Route="Account" />
    </FlyoutItem>
    <Shell.FlyoutFooter>
        <Button
            Command="{Binding CerrarSesionCommand}"
            CornerRadius="0"
            IsVisible="True"
            Text="Cerrar Sesion" />
    </Shell.FlyoutFooter>
</Shell>
